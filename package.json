{
  "name": "zweaq-website",
  "version": "1.0.0",
  "private": true,
  "description": "ZWEAQ ONE — the personal computer you wear. Product website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "STATIC_EXPORT=1 next build",
    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "playwright test",
    "qa:visual": "node scripts/visual-qa.mjs",
    "gen:renders": "node scripts/generate-product-renders.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:static",
    "gen:brand": "node scripts/generate-brand.mjs"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
